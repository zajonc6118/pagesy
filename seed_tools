/* RESIZE                                                */
/* ===================================================== */

window.addEventListener(
  "resize",
  () => {

    const input =
      document.getElementById(
        "processorInput"
      ).value.trim();

    if (input) {
      try {
        processSeeds();
      }
      catch (_) {}
    }
  }
);

